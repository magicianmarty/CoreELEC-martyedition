diff --git a/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.h b/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.h
index 9a830d6..5a83a25 100644
--- a/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.h
+++ b/xbmc/cores/RetroPlayer/buffers/RenderBufferPoolFBO.h
@@ -29,9 +29,9 @@ class CRenderContext;
  * colour texture to.
  *
  * The pool reports itself incompatible with every render setting until
- * Activate() is called. CRPRenderManager picks a renderer by walking the buffer
- * pools and taking the first compatible one, so a pool that answered yes
- * unconditionally would capture software-rendered clients as well.
+ * EnableHardwareRendering() is called. CRPRenderManager picks a renderer by
+ * walking the buffer pools and taking the first compatible one, so a pool that
+ * answered yes unconditionally would capture software clients as well.
  */
 class CRenderBufferPoolFBO : public CBaseRenderBufferPool
 {
@@ -42,17 +42,11 @@ public:
   // implementation of IRenderBufferPool
   bool IsCompatible(const CRenderVideoSettings& renderSettings) const override;
   void DestroyContext() override;
+  void EnableHardwareRendering(bool depth, bool stencil) override;
 
   // implementation of CBaseRenderBufferPool
   IRenderBuffer* CreateRenderBuffer(void* header = nullptr) override;
 
-  /*!
-   * \brief Take over rendering for a client that asked for a GL context
-   *
-   * \param depth The client needs a depth attachment
-   * \param stencil The client needs a stencil attachment
-   */
-  void Activate(bool depth, bool stencil);
 
 protected:
   bool CreateContext();
diff --git a/xbmc/cores/RetroPlayer/rendering/RPRenderManager.cpp b/xbmc/cores/RetroPlayer/rendering/RPRenderManager.cpp
index 2c795d2..043bb09 100644
--- a/xbmc/cores/RetroPlayer/rendering/RPRenderManager.cpp
+++ b/xbmc/cores/RetroPlayer/rendering/RPRenderManager.cpp
@@ -312,10 +312,27 @@ void CRPRenderManager::DestroyContext()
     bufferPool->DestroyContext();
 }
 
-bool CRPRenderManager::Create(unsigned int width, unsigned int height)
+bool CRPRenderManager::Create(unsigned int width, unsigned int height, bool depth, bool stencil)
 {
-  //! @todo
-  return false;
+  bool bSuccess = false;
+
+  // No GL work happens here. The pools create their context and framebuffer
+  // lazily in CreateRenderBuffer(), which runs on the game loop thread, where
+  // the client's context has to be current anyway.
+  for (IRenderBufferPool* bufferPool : m_processInfo.GetBufferManager().GetBufferPools())
+  {
+    bufferPool->EnableHardwareRendering(depth, stencil);
+
+    CRenderVideoSettings renderSettings;
+    if (bufferPool->IsCompatible(renderSettings))
+      bSuccess = true;
+  }
+
+  if (!bSuccess)
+    CLog::Log(LOGERROR, "RetroPlayer[RENDER]: No buffer pool can render a {}x{} hardware frame",
+              width, height);
+
+  return bSuccess;
 }
 
 uintptr_t CRPRenderManager::GetCurrentFramebuffer(unsigned int width, unsigned int height)
@@ -340,7 +357,32 @@ uintptr_t CRPRenderManager::GetCurrentFramebuffer(unsigned int width, unsigned i
 
 void CRPRenderManager::RenderFrame()
 {
-  //! @todo
+  if (m_bFlush || m_state != RENDER_STATE::CONFIGURED)
+    return;
+
+  // The client has finished rendering into the framebuffer it borrowed in
+  // GetCurrentFramebuffer(). Unlike AddFrame() there is no CPU access to close:
+  // a framebuffer was lent, not memory.
+  std::vector<IRenderBuffer*> renderBuffers;
+
+  for (const PendingBuffer& pending : m_pendingBuffers)
+  {
+    pending.buffer->Acquire();
+    renderBuffers.emplace_back(pending.buffer);
+    pending.buffer->Release();
+  }
+  m_pendingBuffers.clear();
+
+  if (renderBuffers.empty())
+    return;
+
+  {
+    std::unique_lock lock(m_bufferMutex);
+
+    for (auto renderBuffer : m_renderBuffers)
+      renderBuffer->Release();
+    m_renderBuffers = std::move(renderBuffers);
+  }
 }
 
 void CRPRenderManager::SetSpeed(double speed)
