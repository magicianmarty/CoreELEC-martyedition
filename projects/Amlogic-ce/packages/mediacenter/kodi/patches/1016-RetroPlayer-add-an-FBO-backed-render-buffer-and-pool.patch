@@ -0,0 +1,78 @@
+/*
+ *  Copyright (C) 2017-2022 Team Kodi
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#pragma once
+
+#include "cores/RetroPlayer/buffers/BaseRenderBufferPool.h"
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+#include "system_gl.h"
+
+namespace KODI
+{
+namespace RETRO
+{
+class CRenderContext;
+
+/*!
+ * \brief Pool of framebuffer-backed buffers for hardware-rendering game clients
+ *
+ * The pool owns a GL context shared with the window system's, made current on
+ * the game loop thread, plus the framebuffer object its buffers attach their
+ * colour texture to.
+ *
+ * The pool reports itself incompatible with every render setting until
+ * Activate() is called. CRPRenderManager picks a renderer by walking the buffer
+ * pools and taking the first compatible one, so a pool that answered yes
+ * unconditionally would capture software-rendered clients as well.
+ */
+class CRenderBufferPoolFBO : public CBaseRenderBufferPool
+{
+public:
+  explicit CRenderBufferPoolFBO(CRenderContext& context);
+  ~CRenderBufferPoolFBO() override;
+
+  // implementation of IRenderBufferPool
+  bool IsCompatible(const CRenderVideoSettings& renderSettings) const override;
+  void DestroyContext() override;
+
+  // implementation of CBaseRenderBufferPool
+  IRenderBuffer* CreateRenderBuffer(void* header = nullptr) override;
+
+  /*!
+   * \brief Take over rendering for a client that asked for a GL context
+   *
+   * \param depth The client needs a depth attachment
+   * \param stencil The client needs a stencil attachment
+   */
+  void Activate(bool depth, bool stencil);
+
+protected:
+  bool CreateContext();
+
+  // Construction parameters
+  CRenderContext& m_context;
+
+  // Configuration parameters
+  EGLDisplay m_eglDisplay{EGL_NO_DISPLAY};
+  EGLConfig m_eglConfig{nullptr};
+  EGLContext m_eglContext{EGL_NO_CONTEXT};
+
+private:
+  bool CreateFramebuffer();
+
+  GLuint m_fboId{0};
+
+  bool m_active{false};
+  bool m_depth{false};
+  bool m_stencil{false};
+};
+} // namespace RETRO
+} // namespace KODI
