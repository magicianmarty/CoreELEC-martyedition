 #include "addons/AddonVersion.h"
@@ -36,17 +49,47 @@
 
 #define REWIND_FACTOR 0.25 // Rewind at 25% of gameplay speed
 
+namespace
+{
+constexpr int MAX_RUNAHEAD_FRAMES = 4;
+
+unsigned int GetRunAheadFrames()
+{
+  int frames =
+      CServiceBroker::GetSettingsComponent()->GetAdvancedSettings()->m_gamesRunAheadFrames;
+
+  // How far ahead to run is a property of the game, not of the installation:
+  // a heavy client cannot afford what a light one can. advancedsettings.xml is
+  // parsed once at startup, so on its own it can only carry one value for all
+  // of them; a home-window property lets the add-on launching a game say what
+  // that game can take.
+  const CGUIWindow* home = CServiceBroker::GetGUI()->GetWindowManager().GetWindow(WINDOW_HOME);
+  if (home != nullptr)
+  {
+    const std::string runAhead = home->GetProperty("retroplayer.runahead").asString();
+    if (!runAhead.empty())
+      frames = std::atoi(runAhead.c_str());
+  }
+
+  return static_cast<unsigned int>(std::clamp(frames, 0, MAX_RUNAHEAD_FRAMES));
+}
+} // namespace
+
 CReversiblePlayback::CReversiblePlayback(GAME::CGameClient* gameClient,
                                          CRPRenderManager& renderManager,
                                          CGUIGameMessenger& guiMessenger,
                                          double fps,
-                                         size_t serializeSize)
+                                         size_t serializeSize,
+                                         CRPStreamManager* streamManager)
   : m_gameClient(gameClient),
     m_renderManager(renderManager),
+    m_streamManager(streamManager),
     m_guiMessenger(guiMessenger),
     m_gameLoop(this, fps),
     m_savestateDatabase(new CSavestateDatabase)
 {
+  m_runAheadFrames = GetRunAheadFrames();
+
   UpdateMemoryStream();
 
   GAME::CGameSettings& gameSettings = CServiceBroker::GetGameServices().GameSettings();
@@ -355,12 +398,73 @@
 
 void CReversiblePlayback::FrameEvent()
 {
-  m_gameClient->RunFrame();
+  if (m_runAheadFrames > 0)
+    RunAheadFrame();
+  else
+    m_gameClient->RunFrame();
+
   UpdateFrameRate();
 
   AddFrame();
 }
 
+void CReversiblePlayback::RunAheadFrame()
+{
+  // Show the client further ahead than it has actually got to.
+  //
+  // The client is run once for the frame the emulation genuinely advances to,
+  // and then again for each frame of run-ahead; only the last of those is
+  // heard, and it is the one left on screen. Restoring the state saved after
+  // the first run puts the emulation back where it belongs, so it still moves
+  // one frame per tick - but what the player sees and hears is that many
+  // frames further on, and their input appears to take effect that much
+  // sooner.
+  //
+  // Audio has to come from the last run rather than the first: the same frames
+  // are re-run every tick, so it is the last ones that form a continuous
+  // stream. Video needs no such care - the client simply draws over its
+  // previous output and the final frame is the one that stands.
+  const size_t serializeSize = m_gameClient->GetSerializeSize();
+  if (serializeSize == 0 || m_streamManager == nullptr)
+  {
+    // A client that cannot serialise cannot do this. Say so once and carry on
+    // normally rather than paying the cost for no benefit.
+    CLog::Log(LOGWARNING, "RetroPlayer[RUNAHEAD]: Client cannot save state, running ahead disabled");
+    m_runAheadFrames = 0;
+    m_gameClient->RunFrame();
+    return;
+  }
+
+  if (m_runAheadState.size() != serializeSize)
+    m_runAheadState.resize(serializeSize);
+
+  m_streamManager->EnableAudio(false);
+
+  m_gameClient->RunFrame();
+
+  if (!m_gameClient->Serialize(m_runAheadState.data(), serializeSize))
+  {
+    CLog::Log(LOGWARNING, "RetroPlayer[RUNAHEAD]: Failed to save state, running ahead disabled");
+    m_runAheadFrames = 0;
+    m_streamManager->EnableAudio(true);
+    return;
+  }
+
+  for (unsigned int frame = 1; frame <= m_runAheadFrames; ++frame)
+  {
+    if (frame == m_runAheadFrames)
+      m_streamManager->EnableAudio(true);
+
+    m_gameClient->RunFrame();
+  }
+
+  if (!m_gameClient->Deserialize(m_runAheadState.data(), serializeSize))
+  {
+    CLog::Log(LOGERROR, "RetroPlayer[RUNAHEAD]: Failed to restore state, running ahead disabled");
+    m_runAheadFrames = 0;
+  }
+}
+
 void CReversiblePlayback::RewindEvent()
 {
   RewindFrames(1);
