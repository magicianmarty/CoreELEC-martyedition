set -e; \
cd "/work/build.CoreELEC-Amlogic-no.aarch64-22/install_pkg/attr-2.6.0/usr/share/man"; \
for d in man/man1/attr.1 man/man1/getfattr.1 man/man1/setfattr.1 man/man3/attr_get.3 man/man3/attr_list.3 man/man3/attr_multi.3 man/man3/attr_remove.3 man/man3/attr_set.3; do \
	man_section=${d##*.}; \
	d=${d#man/}; \
	dst=${d##*/}; \
	for m in `gawk \
		'/^\.S[h|H] NAME/ {ok=1; next} ok {print; exit}' $d \
		| /work/build.CoreELEC-Amlogic-no.aarch64-22/toolchain/bin/sed \
			-e 's/^\.Nm //' -e 's/,/ /g' -e 's/\\-.*//' \
			-e 's/\\\f[0-9]//g' -e 's/  / /g;q'`; \
	do \
		[ "$m" = "\\" ] && continue; \
		ln="man$man_section/$m.$man_section"; \
		[ -e "$ln" ] && continue; \
		echo ln -s $dst $ln; \
		ln -s $dst $ln; \
	done; \
done
